 "poems": [
  {
   "seq": "1",
   "text": "をのつからすゝつ空もしらるゝやこの夜明行鳥のくつこゑ",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "十一暁立春",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "つきるとも春はとおもふ雪もよに猶さえくらす谷のした風",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "渓余寒",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "吹かくる峯の杉原のあさかすみはれてあらしや又くそるらん",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "檜原霞",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "さとまてとおもふもとをし見渡せはかすむいくたの森の下道",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜霞",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "うくひ寿の声する道においてあせられたとる逢坂の山",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "名所鶯",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "うきむれてわかな楠なり都とてはやくものへの雪はつねは",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "若菜",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "むすへみもみとりそひ行若草のねたくや春の霜は消ら",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "草漸青",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "春風も人をそいかむとはてゆく袖にもおしきやとの梅かね",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "里梅",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "舟つなくたよりもあるかましもりわかかとちかき青様のかけ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "門柳",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "ましれつゝはやくも咲とさへる花散らすんあれやおしみやはさぬ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初花",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "ひかりある花の木すゑの朝かすみうつろはんとも見えぬ色かな",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "朝花",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "みつゝやくよし野は山のおくもなしみねもふそとも花に忘れて",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "峰花",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "人すまぬおれつ嶋にも咲はなのかけとそあるしにやとめまし",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "嶋花",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "いさ桜我もといはぬ身のうきもよしやしはしと尤そ残れる",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "さす塩のみつのはま風よろゝは深したる月そ浪にかすめる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浜春月",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "雁かへるしかのうらなみ末かけて思もとをしみこしちの空",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖帰丁",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "底きよし色手にすめる池水や藤さく松のかけをしるらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松藤",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "苗まくや鳥をふ尋被遠近に水せきかけてかへす荒小ま",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "苗代",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "一枝は手折て行ん山吹の花はうつろふかせなさくとも",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "折款冬",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "花ちりて春はかきりと思ひしに残る日数のくるゝにもうし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮春",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "夏まては心ありけるこゝかな春はなへての花とこそみめ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遅桜",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "卯花のさける岸かけ水もなしいかなる波のかけて行らん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "岸卯花",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "しのふへき誰ゆへさてもほとゝきすまつ人とにつれなかるらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "待郭公",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "そことなき木の舟路のほときひなく音にあけて山も見へけり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海時鳥",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "入月もおなしと間のほとゝきす山のあなしの誰をとふらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遠時鳥",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "一たか袖にゆくす色とも手折ましくれなゐうすきなてしこの図",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "瞿麦",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "うえわたは田面の末は野をかけてをかへのさとに早苗とるなり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "岡邉早苗",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "ともしたて帰るますらお木隠のしるへはかりの月はもるらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "樹陰照射",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "五月雨はかひやかしたも水こえて雲そ気ふりにたちかはりし間",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "五月西",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "果ゝり火の猶とをさかる転かひ舟いま一さにやさしのほるらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鵜川",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "月も猶おなしむかしともりくるやはなたち花のかほる軒はに",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "釜恵橋",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "此まゝにほさてやねなん旅ころも日も夕立の雲のしたみち",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅夕立",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "けふりにてたつ蚊に声も遠しかる野へのほたるの何とも遊らん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野蛍",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "ふみ分て此さとへやすゝむらんしけわをくるゝ山のかけ草",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "納涼",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "ことしはやけふをなかはのみそき河りかよわひとも思はましかは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "六月抜",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "うちるひく小まの早笛の一穂にもふを見せたるけさの初風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早秋",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "らすくなる光もかなしたなはたのわかれにちかきあけかしかき",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕図",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "そめてみんけるをもまして華か元の下葉の露をはらぬ秋かせ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "菊風",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "華の葉に音するほとや吹さらんまかきあらさぬ庭の夕かけ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "籬萩",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "行人のたちもかへらすはなすゝき屏ては何と猶まねくらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "行路薄",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "をくれけん雲路はいつく雁のなくおなし田面におつる一つら",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田上雁",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "あはれをもうきをもしらしに鹿鳴外山のさとの秋をみはすは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "外山鹿",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "吹しほる袖の秋風身にしみて夕露わくるなすのしの原",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "原露",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "なかしともおもひわかてやきり〳〵す秋の夜をしも鳴あかすらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜末",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "舟よはふ里はむかひにとをからて波間へたつる淀のつきり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "渡霧",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "名にしおふこよひのかけも望月の駒引こゆるあつる地の山",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "駒近",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "波風のうきねなりとも凌見かたせき路の月はたれりみさらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関月",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "なひきあふ竹のさ枝にもる月の影さゝまらぬ胡風そふく",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "竹間月",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "心すむあかしのうらの月にこそこのや身さともとはまほしけれ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浦月",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "ふりはてゝしけき板間の月もみつうきすまひとや人はいふりん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "古宅月",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "にてもなき空にすめるはしつかにて彼間の月や影さはくらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浪月",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "う地重遊むあしやの里のあき衣しのにおりはへいまやほすらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "擣衣",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "晴やらぬ雲は時雨をこゝろにてふりみふらすみ秋さむきそう",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋時雨",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "もみちかり時雨を袖につくすむ心に秋の色をふかめて",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "しはしともいはていかるゝ余よなと行衛をたにもしらざはせぬ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "九月画",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "一献もこてこゝゝゝ冬の来てあらはにみゆる野へのいろかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初冬",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "此ころは地れるもおちの紅にそめてそさらす布川の滝",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "滝紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "霜むすふ岩根の小篠う地そよき音すさましき庭のやり水",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭霜",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "一袖立とみ真栄をひろふ山かつは玉とてしらてちる霞かな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "柴霰",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "大ひえやよ河のみねをこしてこそ浦こく舟も雪はみつらめ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "嶺雪",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "人とはぬしるしなりけり山里の雪になとなき杉のした道",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杉野",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "さそひくる雪はこすへに積りけりもみちはちりし木枯のもり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜雪",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "あまへやこれも妻木と求けん霜のかれはのあしさたくかけ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "枯茸",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "中たえて月もかひなく杣川の氷のうへをくらすいかしこし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杣寒月",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "友なひてたつや磯部のさよ千鳥波のうきねをおほし心に",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "磯千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "さひしさに鳥の空ねもかこつまて猶明ゆらぬ冬の夜なかき",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬暁",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "こす塩のしたにこほれる湊川水をへたてゝなおや行らん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河氷",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "鳥立する尾上のとをへれたてゝ駒をはやむる野へのかり人",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鷹狩",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "何をそのおもふ事とて沢水にうえる鳥のこゑかはすらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "沢水鳥",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "つもりては老となりぬる哀をもしらでやとしの暮て行らん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "契りたえはかなかたしとつれなくはおもひしるまて身をやつくさん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不逢恋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "おしとおもふ命もかろし何を身のくるしきこひと人にしらせん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "切忍",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "はなしみなとし道のわりなさもおもひしらすはうちのこと人",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遠慮",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "た地なれてつらきけしきをみるもうしこひしくてゝは思ひくらあ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "近恋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "あはさらはかゝるわかれもなからまし恋そむくひのた地なりける",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "別点閉居長忍応片画"
  },
  {
   "seq": "76",
   "text": "一我ためにこはたの里の馬もかな人のか地ににをくるゝもうき",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "負恋",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "おもひねにかならすかよふ谷もなし人やゆるしておふとみつらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "逢夢恋",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "しらす猶露の命の残るかな思ひさえにしさぬゝのあと",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "後朝応",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "きくのみはあやめもわかすあやめ草ねたくも人にひく心かな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "聞恋",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "あかりこりしおもかけとめて夕魚の露わすれすもぬるゝ袖哉",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "久慈",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "あぶるになさはさもこそ有明の暁いてゝ見るほともなし",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "白地恋",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "何とかゝなけの情もなかるらんうらみは人のあわぬのみかわ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恨恋",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "たちかへり又いたらんもいさやかはたれせきとめて逢瀬絶けん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "絶惑",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "かわるなといかたひ人にちきるらん身の行末は我もしらしを",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "契恋",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "恋せしのみそきを神のうけこらはおもふす地をや猶いのらまし",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "祈ゑ",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "一ふえの音による行鹿もいつはりのあるせかなしきものおもふらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "偽恋",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "あらすなるへの心にくさも木も霜をきてこそ色かはりぬれ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "変恋",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "うきねするたみのゝ鳴のあま衣ぬれすはこゝる月をみましや",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄衣雑",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "ともなくてひとりぬる夜の手枕はあけぬものとや思のとめん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄枕雑",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "花ならぬ心のうへにかけてみはさけ藁木も色やなからん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄筆雑",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "市人のかへりすみぬるしかまつたぎつるなみや猶さはくらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄市雑",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "いかにこしよるの舟路そ浪風のなこりは今朝も猶そはげしき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄舟雑",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "名はかりはなからのはしと残る世に我身ふりぬるたくひもそなき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄橋雑",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "鐘の夢に分こし峯を見渡せは我跡とめて自はいて気り",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄鐘雑",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "秋ことに草のかつらの折ぬるもあわれいくよの霜の松かえ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄木雑",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "くち残る苔の埋れ木あはれ又いつをしのふの草と生けん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄苔雑",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "あらにちる露ともいかていはし水結ふ手とに千世を駕へて",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄水雑",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "きのふまて雪にみなれし山の端も霞に明て春やたつらん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "立春",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "いつくそと四方の梢もしら衣のたぎかさなれかあさ霞かな",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "朝霞",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "谷の戸を都に出るらくひすの声にも春の色やそふらん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "谷鶯",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "さえかへり風にや来るやまかけはつれなく残るこその白",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734028",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残雪",
   "kotobagaki": ""
  }
 ],
